page{background:#fff8ed;color:#3d3966;font-family:"Arial Rounded MT Bold","PingFang SC",sans-serif}button{box-sizing:border-box;margin:0;padding:0;display:flex;align-items:center;justify-content:center;line-height:1.2;border:0;font-family:inherit}button::after{display:none}.page{position:relative;min-height:100vh;padding:22rpx 36rpx calc(52rpx + env(safe-area-inset-bottom));box-sizing:border-box;overflow:hidden;background:linear-gradient(180deg,#fff9ef 0%,#fff3e4 100%)}.confetti{position:absolute;opacity:.6;pointer-events:none}.confetti-one{right:-8rpx;top:350rpx;width:62rpx;height:16rpx;border-radius:99rpx;background:#ff9581;transform:rotate(32deg)}.confetti-two{left:10rpx;top:790rpx;width:24rpx;height:24rpx;border:6rpx solid #82d9b5;transform:rotate(20deg)}.topbar{position:relative;z-index:2;height:88rpx;display:flex;align-items:center;justify-content:space-between}.back-button{width:72rpx;height:72rpx;border:3rpx solid #3d3966;border-radius:22rpx;background:#fff;box-shadow:0 4rpx 0 #3d3966}.back-arrow{width:17rpx;height:17rpx;border-left:4rpx solid #3d3966;border-bottom:4rpx solid #3d3966;transform:rotate(45deg);margin-left:8rpx}.back-pressed{transform:translateY(3rpx);box-shadow:0 1rpx 0 #3d3966}.lesson-step{display:flex;align-items:center;min-height:48rpx;padding:0 19rpx;border:3rpx solid #3d3966;border-radius:999rpx;background:#d8ccff;font-size:22rpx;font-weight:800}.duration{width:72rpx;text-align:right;color:#716d87;font-size:20rpx}.lesson-heading{position:relative;z-index:2;display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;margin-top:30rpx}.lesson-heading>view:first-child{flex:1}.eyebrow{display:inline-flex;align-items:center;gap:9rpx;min-height:40rpx;padding:0 16rpx;border:3rpx solid #3d3966;border-radius:999rpx;background:#fff0b8;color:#8e6407;font-size:20rpx;font-weight:800;box-shadow:4rpx 4rpx 0 #3d3966}.eyebrow-dot{width:12rpx;height:12rpx;border-radius:50%;background:#e5aa26}.title{margin-top:23rpx;font-size:48rpx;font-weight:800;line-height:1.25}.subtitle{margin-top:11rpx;color:#716d87;font-family:"PingFang SC",sans-serif;font-size:24rpx;line-height:1.5}.theory-buddy{position:relative;flex:none;width:91rpx;height:77rpx;margin-top:5rpx;border:4rpx solid #3d3966;border-radius:50% 45% 54% 46%;background:#ffd45f;box-shadow:6rpx 7rpx 0 #3d3966;transform:rotate(5deg)}.buddy-eye{position:absolute;top:27rpx;width:8rpx;height:11rpx;border-radius:50%;background:#3d3966}.buddy-eye.left{left:26rpx}.buddy-eye.right{right:26rpx}.buddy-smile{position:absolute;left:36rpx;top:43rpx;width:20rpx;height:9rpx;border-bottom:4rpx solid #3d3966;border-radius:0 0 20rpx 20rpx}
.keyboard-card{position:relative;z-index:2;margin-top:40rpx;padding:28rpx 20rpx 20rpx;border:4rpx solid #3d3966;border-radius:32rpx;background:#ff9a86;box-shadow:8rpx 9rpx 0 #3d3966}.keyboard-label{display:inline-flex;align-items:center;min-height:38rpx;padding:0 15rpx;margin-bottom:20rpx;border:3rpx solid #3d3966;border-radius:999rpx;background:#fff;color:#3d3966;font-size:19rpx;font-weight:800}.keyboard{position:relative;height:218rpx;padding:0 8rpx 8rpx;border:4rpx solid #3d3966;border-radius:22rpx;background:#3d3966;overflow:hidden}.white-keys{height:205rpx;display:flex;align-items:flex-end}.white-keys text{height:196rpx;line-height:255rpx;flex:1;text-align:center;background:#fff;border-right:3rpx solid #3d3966;color:#706b86;font-size:20rpx;font-weight:700}.white-keys text:first-child{border-radius:11rpx 0 0 11rpx}.white-keys text:last-child{border-radius:0 11rpx 11rpx 0;border-right:0}.black-keys{position:absolute;left:58rpx;right:58rpx;top:0;height:118rpx;display:flex;justify-content:space-between}.black-keys text{width:44rpx;height:120rpx;border:3rpx solid #3d3966;border-top:0;border-radius:0 0 10rpx 10rpx;background:#3d3966;color:#ffd45f;text-align:center;line-height:100rpx;font-size:23rpx}.black-keys text:empty{visibility:hidden}
.explain-card,.check-card{position:relative;z-index:2;margin-top:34rpx;padding:34rpx 28rpx 28rpx;border:4rpx solid #3d3966;border-radius:30rpx;background:#fff;box-shadow:7rpx 8rpx 0 #3d3966}.card-tab{position:absolute;left:28rpx;top:-22rpx;display:flex;align-items:center;min-height:40rpx;padding:0 15rpx;border:3rpx solid #3d3966;border-radius:12rpx;background:#82d9b5;font-size:19rpx;font-weight:800;transform:rotate(-2deg)}.question,.check-title{display:block;font-size:29rpx;font-weight:800;margin-bottom:13rpx}.body{display:block;color:#67637e;font-family:"PingFang SC",sans-serif;font-size:23rpx;line-height:1.75}.sound-row{position:relative;width:100%;min-height:112rpx;display:flex;align-items:center;justify-content:flex-start;margin-top:25rpx;padding:14rpx 16rpx;border:3rpx solid #3d3966;border-radius:24rpx;background:#fff0b8;color:#3d3966;text-align:left;box-shadow:0 5rpx 0 #3d3966}.sound-pressed{transform:translateY(3rpx);box-shadow:0 2rpx 0 #3d3966}.sound-button{flex:none;display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;border:3rpx solid #3d3966;border-radius:50%;background:#ff9581}.play-shape{width:0;height:0;margin-left:5rpx;border-top:12rpx solid transparent;border-bottom:12rpx solid transparent;border-left:19rpx solid #3d3966}.stop-shape{width:21rpx;height:21rpx;border-radius:4rpx;background:#3d3966}.sound-row>view:nth-child(2){min-width:0;margin-left:17rpx}.sound-title{display:block;font-size:24rpx;font-weight:800}.sound-copy{display:block;color:#6f6a84;font-family:"PingFang SC",sans-serif;font-size:19rpx;margin-top:5rpx}.sound-wave{display:flex;align-items:center;gap:4rpx;margin-left:auto}.sound-wave view{width:5rpx;height:20rpx;border-radius:99rpx;background:#3d3966}.sound-wave view:nth-child(2){height:34rpx}.sound-wave view:nth-child(3){height:14rpx}
.check-card{background:#eee8ff}.check-heading{display:flex;align-items:center;gap:12rpx;margin-bottom:11rpx}.question-mark{display:flex;align-items:center;justify-content:center;width:40rpx;height:40rpx;border:3rpx solid #3d3966;border-radius:50%;background:#ffd45f;font-size:24rpx;font-weight:800}.check-title{margin:0}.answer-row{display:flex;gap:18rpx;margin-top:23rpx}.answer-button{flex:1;min-height:82rpx;border:3rpx solid #3d3966;border-radius:20rpx;background:#fff;color:#3d3966;font-size:24rpx;font-weight:800;box-shadow:0 5rpx 0 #3d3966}.answer-selected{background:#ffd45f}.answer-pressed{transform:translateY(3rpx);box-shadow:0 2rpx 0 #3d3966}.answer-hint{display:block;margin-top:20rpx;color:#a45c42;font-family:"PingFang SC",sans-serif;font-size:21rpx;font-weight:600}.answer-hint.correct{color:#26735e}.primary{position:relative;z-index:2;width:100%;min-height:92rpx;margin-top:38rpx;border:4rpx solid #3d3966;border-radius:24rpx;background:#7f6edd;color:#fff;font-size:27rpx;font-weight:800;box-shadow:0 7rpx 0 #3d3966}.primary-pressed{transform:translateY(5rpx);box-shadow:0 2rpx 0 #3d3966}
@media (min-width:600px){.page{padding-left:calc((100vw - 720rpx)/2);padding-right:calc((100vw - 720rpx)/2)}}
@media (prefers-reduced-motion:reduce){.sound-row,.answer-button,.primary{transition:none}}
