.page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background:
    radial-gradient(circle at 94% 10%, rgba(184, 175, 193, 0.2) 0 64rpx, transparent 66rpx),
    linear-gradient(180deg, #fbf9fb 0%, var(--leta-bg) 100%);
}

.lesson-meta {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 64rpx;
}

.lesson-step {
  flex: none;
  padding: 10rpx 16rpx;
  border: 2rpx solid var(--leta-border);
  border-radius: 999rpx;
  background: var(--leta-theory-soft);
  color: #805c12;
  font-size: 24rpx;
  font-weight: 650;
}

.lesson-progress {
  display: flex;
  flex: 1;
  gap: 7rpx;
}

.lesson-progress view {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--leta-border);
}

.lesson-progress view:nth-child(-n+2),
.lesson-progress .current { background: var(--leta-theory); }

.duration {
  flex: none;
  color: var(--leta-text-secondary);
  font-size: 23rpx;
}

.lesson-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 34rpx;
}

.heading-copy { flex: 1; min-width: 0; }

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 48rpx;
  padding: 0 18rpx;
  border: 2rpx solid var(--leta-border);
  border-radius: 999rpx;
  background: var(--leta-theory-soft);
  color: #805c12;
  font-size: 24rpx;
  font-weight: 600;
}

.eyebrow-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--leta-theory); }
.title { margin-top: 22rpx; font-size: 46rpx; font-weight: 700; line-height: 1.3; }
.subtitle { margin-top: 10rpx; color: var(--leta-text-secondary); font-size: 27rpx; line-height: 1.6; }

.keyboard-card,
.explain-card,
.check-card {
  position: relative;
  box-sizing: border-box;
  margin-top: 38rpx;
  padding: 28rpx;
  border: 2rpx solid var(--leta-border);
  border-radius: 32rpx;
  background: var(--leta-surface);
  box-shadow: var(--leta-shadow-card);
}

.keyboard-card { background: linear-gradient(145deg, var(--leta-theory-soft), #fff); }
.keyboard-label { display: inline-flex; padding: 9rpx 16rpx; border-radius: 999rpx; background: #fff; color: #805c12; font-size: 23rpx; font-weight: 650; }

.keyboard {
  position: relative;
  height: 214rpx;
  margin-top: 20rpx;
  padding: 0 6rpx 6rpx;
  border: 3rpx solid var(--leta-text);
  border-radius: 20rpx;
  background: var(--leta-text);
  overflow: hidden;
}

.white-keys { display: flex; height: 205rpx; align-items: flex-end; }
.white-keys text { flex: 1; height: 198rpx; border-right: 2rpx solid var(--leta-border); background: #fff; color: var(--leta-text-secondary); font-size: 22rpx; font-weight: 600; line-height: 272rpx; text-align: center; }
.white-keys text:first-child { border-radius: 10rpx 0 0 10rpx; }
.white-keys text:last-child { border-right: 0; border-radius: 0 10rpx 10rpx 0; }
.black-keys { position: absolute; left: 56rpx; right: 56rpx; top: 0; display: flex; justify-content: space-between; height: 116rpx; }
.black-keys text { width: 44rpx; height: 116rpx; border-radius: 0 0 9rpx 9rpx; background: var(--leta-text); color: var(--leta-theory); font-size: 24rpx; line-height: 98rpx; text-align: center; }
.black-keys text:empty { visibility: hidden; }
.keyboard-hint { display: block; margin-top: 18rpx; color: var(--leta-text-secondary); font-size: 24rpx; line-height: 1.5; text-align: center; }

.card-tab { display: inline-flex; margin-bottom: 20rpx; padding: 8rpx 15rpx; border-radius: 999rpx; background: var(--leta-instrument-soft); color: var(--leta-primary); font-size: 22rpx; font-weight: 600; }
.question { display: block; font-size: 31rpx; font-weight: 700; }
.body { display: block; margin-top: 14rpx; color: var(--leta-text-secondary); font-size: 27rpx; line-height: 1.75; }

.sound-row {
  width: 100%;
  min-height: 112rpx;
  margin-top: 24rpx;
  padding: 14rpx 18rpx;
  justify-content: flex-start;
  border: 2rpx solid var(--leta-border);
  border-radius: 24rpx;
  background: var(--leta-theory-soft);
  color: var(--leta-text);
  text-align: left;
  transition: opacity 180ms ease, transform 180ms ease;
}

.sound-row.playing { background: var(--leta-instrument-soft); }
.sound-button { display: flex; align-items: center; justify-content: center; flex: none; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--leta-primary); }
.play-shape { width: 0; height: 0; margin-left: 5rpx; border-top: 11rpx solid transparent; border-bottom: 11rpx solid transparent; border-left: 18rpx solid #fff; }
.stop-shape { width: 22rpx; height: 22rpx; border-radius: 5rpx; background: #fff; }
.sound-copy-wrap { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 5rpx; margin-left: 18rpx; }
.sound-title { font-size: 27rpx; font-weight: 650; }
.sound-copy { color: var(--leta-text-secondary); font-size: 23rpx; }
.sound-wave { display: flex; align-items: center; gap: 5rpx; height: 50rpx; margin-left: 12rpx; }
.sound-wave view { width: 6rpx; border-radius: 999rpx; background: var(--leta-primary); }
.sound-wave view:nth-child(1) { height: 18rpx; }
.sound-wave view:nth-child(2) { height: 42rpx; }
.sound-wave view:nth-child(3) { height: 28rpx; }
.sound-pressed { opacity: 0.72; transform: scale(0.99); }

.check-heading { display: flex; align-items: center; gap: 12rpx; }
.question-mark { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 16rpx; background: var(--leta-practice-soft); color: var(--leta-primary); font-size: 27rpx; font-weight: 700; }
.check-title { font-size: 30rpx; font-weight: 700; }
.answer-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 24rpx; }
.answer-button { min-height: 88rpx; border: 2rpx solid var(--leta-border); border-radius: 22rpx; background: var(--leta-surface-soft); color: var(--leta-text); font-size: 27rpx; font-weight: 600; }
.answer-button.answer-selected { border-color: var(--leta-primary); background: var(--leta-practice-soft); color: var(--leta-primary); }
.answer-pressed { opacity: 0.7; }
.answer-hint { display: flex; align-items: center; gap: 12rpx; margin-top: 22rpx; padding: 16rpx; border-radius: 18rpx; background: #faece9; color: var(--leta-error); font-size: 24rpx; line-height: 1.5; }
.answer-hint.correct { background: var(--leta-instrument-soft); color: var(--leta-success); }
.answer-status-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 38rpx; height: 38rpx; border: 2rpx solid currentColor; border-radius: 50%; font-size: 21rpx; font-weight: 700; }

.primary { width: 100%; min-height: 96rpx; margin-top: 36rpx; border: 0; border-radius: 24rpx; background: var(--leta-primary); color: #fff; font-size: 29rpx; font-weight: 650; box-shadow: 0 8rpx 20rpx rgba(117, 106, 138, 0.22); transition: opacity 180ms ease, transform 180ms ease; }
.primary-pressed { opacity: 0.82; transform: scale(0.985); }

@media (min-width: 600px) {
  .page { max-width: 760rpx; margin: 0 auto; }
}

@media (orientation: landscape) {
  .page { max-width: 720rpx; margin: 0 auto; }
}
