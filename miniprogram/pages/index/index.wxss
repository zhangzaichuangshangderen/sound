.page-shell {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 92% 8%, rgba(210, 194, 224, 0.2) 0 58rpx, transparent 60rpx),
    linear-gradient(180deg, #fdfbfe 0%, var(--leta-bg) 100%);
}

.content {
  height: calc(100vh - 136rpx - env(safe-area-inset-bottom));
}

.page-content {
  box-sizing: border-box;
  padding: 36rpx 32rpx 64rpx;
}

.page-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.heading-copy {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 48rpx;
  padding: 0 18rpx;
  border: 2rpx solid var(--leta-border);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.eyebrow-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.sing-tone { color: #805c66; background: var(--leta-sing-soft); }
.instrument-tone { color: #675d72; background: var(--leta-instrument-soft); }
.theory-tone { color: #765d23; background: var(--leta-theory-soft); }
.practice-tone,
.me-tone { color: #466a83; background: var(--leta-practice-soft); }

.page-title {
  max-width: 520rpx;
  margin-top: 22rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.32;
  letter-spacing: -1rpx;
}

.marker {
  display: inline;
  margin-left: 8rpx;
  padding: 0 4rpx;
  border-radius: 8rpx;
}

.marker-sing { background: linear-gradient(transparent 60%, rgba(185, 130, 143, 0.24) 60%); }
.marker-mint { background: linear-gradient(transparent 60%, rgba(145, 132, 158, 0.28) 60%); }
.marker-yellow { background: linear-gradient(transparent 60%, rgba(168, 155, 175, 0.28) 60%); }
.marker-lavender { background: linear-gradient(transparent 60%, rgba(169, 160, 178, 0.3) 60%); }

.page-subtitle {
  margin-top: 12rpx;
  color: var(--leta-text-secondary);
  font-size: 28rpx;
  line-height: 1.65;
}

.feature-card,
.today-card,
.progress-card {
  position: relative;
  box-sizing: border-box;
  margin-top: 40rpx;
  padding: 32rpx;
  border: 2rpx solid var(--leta-border);
  border-radius: 36rpx;
  box-shadow: var(--leta-shadow-card);
  overflow: hidden;
}

.feature-card { min-height: 338rpx; }
.feature-sing { margin-top: 12rpx; background: linear-gradient(145deg, #fff 0%, #eee9f0 100%); }

.feature-copy-block {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  max-width: 100%;
}

.feature-badge,
.today-label {
  align-self: flex-start;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: var(--leta-sing-soft);
  color: #805c66;
  font-size: 24rpx;
  font-weight: 600;
}

.feature-title {
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.feature-copy {
  margin-top: 10rpx;
  color: var(--leta-text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.primary-button {
  position: relative;
  z-index: 2;
  width: 100%;
  min-height: 96rpx;
  margin-top: 30rpx;
  border: 0;
  border-radius: 24rpx;
  background: var(--leta-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 650;
  box-shadow: 0 8rpx 20rpx rgba(117, 106, 138, 0.22);
  transition: opacity 180ms ease, transform 180ms ease, box-shadow 180ms ease;
}

.feature-card .primary-button {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  width: auto;
}

.primary-button.compact { margin-top: 28rpx; min-height: 88rpx; }
.is-pressed { opacity: 0.82; transform: scale(0.985); box-shadow: none; }

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 40rpx 2rpx 18rpx;
}

.section-title { font-size: 30rpx; font-weight: 700; }
.section-hint { color: var(--leta-text-secondary); font-size: 24rpx; }

.secondary-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 16rpx;
  width: 100%;
}

.single-note-card,
.tip-card,
.course-card,
.lesson-card {
  width: 100%;
  min-height: 116rpx;
  padding: 20rpx 24rpx;
  justify-content: flex-start;
  border: 2rpx solid var(--leta-border);
  border-radius: 28rpx;
  background: var(--leta-surface);
  color: var(--leta-text);
  box-shadow: var(--leta-shadow-card);
  text-align: left;
  transition: opacity 180ms ease, transform 180ms ease;
}
.ear-training-card { background: linear-gradient(145deg, #fff 0%, var(--leta-theory-soft) 100%); }
.ear-training-icon { position: relative; display: flex; align-items: center; justify-content: center; flex: none; width: 72rpx; height: 72rpx; border-radius: 22rpx; background: #fff; }
.ear-training-icon view { width: 7rpx; margin: 0 4rpx; border-radius: 99rpx; background: var(--leta-primary); }
.ear-training-icon view:nth-child(1) { height: 20rpx; }
.ear-training-icon view:nth-child(2) { height: 38rpx; }
.ear-training-icon view:nth-child(3) { height: 26rpx; }

.secondary-actions > .single-note-card,
.secondary-actions > .tip-card {
  box-sizing: border-box;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin: 0;
}

.single-note-icon,
.tip-icon,
.book-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: var(--leta-instrument-soft);
}

.note-orbit {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--leta-primary);
  border-radius: 50%;
}

.note-core { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--leta-sing); }

.single-note-copy,
.tip-content,
.lesson-info,
.course-info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 7rpx;
  margin-left: 20rpx;
}

.single-note-copy text:first-child,
.tip-title,
.lesson-title,
.course-title { font-size: 28rpx; font-weight: 650; }

.single-note-copy text:last-child,
.lesson-copy,
.course-copy { color: var(--leta-text-secondary); font-size: 24rpx; line-height: 1.45; }

.tip-card { background: var(--leta-surface); }
.tip-icon { background: var(--leta-theory-soft); }
.tip-label { color: #6b6073; font-size: 22rpx; font-weight: 600; }

.tip-note {
  position: relative;
  box-sizing: border-box;
  width: 38rpx;
  height: 32rpx;
  border: 3rpx solid var(--leta-text);
  border-radius: 7rpx;
  background: #fff;
}

.tip-note::after {
  content: "";
  position: absolute;
  left: 16rpx;
  top: -3rpx;
  bottom: -3rpx;
  width: 3rpx;
  background: var(--leta-text);
}

.chevron {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin-left: auto;
  border-top: 3rpx solid var(--leta-text-secondary);
  border-right: 3rpx solid var(--leta-text-secondary);
  transform: rotate(45deg);
}

.card-pressed { opacity: 0.72; transform: scale(0.99); }

.instrument-tool-card { position: relative; display: flex; box-sizing: border-box; width: 100%; min-width: 100%; max-width: none; min-height: 330rpx; margin: 0; padding: 28rpx; align-items: stretch; justify-content: space-between; flex-direction: column; border: 2rpx solid var(--leta-border); border-radius: 36rpx; background: linear-gradient(145deg, #fff 0%, #f5eff9 100%); color: var(--leta-text); box-shadow: var(--leta-shadow-card); text-align: left; }
.instrument-card-main { display: flex; width: 100%; min-width: 0; align-items: center; justify-content: space-between; }
.tool-metronome { position: relative; flex: none; width: 132rpx; height: 150rpx; margin-left: 24rpx; }
.tool-metronome-body { position: absolute; left: 17rpx; right: 17rpx; bottom: 0; height: 126rpx; border: 3rpx solid #8b70a1; border-radius: 26rpx 26rpx 20rpx 20rpx; background: linear-gradient(160deg, #dac9e7, #b99dce); clip-path: polygon(31% 0, 69% 0, 100% 100%, 0 100%); box-shadow: inset 0 0 0 6rpx rgba(255,255,255,.2); }
.tool-metronome-arm { position: absolute; z-index: 2; left: 63rpx; bottom: 27rpx; width: 6rpx; height: 98rpx; border-radius: 99rpx; background: #fffafc; transform: rotate(-13deg); transform-origin: 50% 100%; }
.tool-metronome-pivot { position: absolute; z-index: 3; left: 56rpx; bottom: 19rpx; width: 22rpx; height: 22rpx; border: 5rpx solid #fffafc; border-radius: 50%; background: #9a7fb8; }
.tool-metronome-eye { position: absolute; z-index: 4; bottom: 62rpx; width: 8rpx; height: 11rpx; border-radius: 50%; background: #5f506a; }
.tool-metronome-eye.eye-left { left: 48rpx; }
.tool-metronome-eye.eye-right { right: 48rpx; }
.tool-metronome-smile { position: absolute; z-index: 4; left: 59rpx; bottom: 47rpx; width: 16rpx; height: 9rpx; border-bottom: 3rpx solid #5f506a; border-radius: 0 0 16rpx 16rpx; }
.instrument-tool-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.instrument-tool-kicker { align-self: flex-start; padding: 7rpx 14rpx; border-radius: 999rpx; background: var(--leta-primary-soft); color: var(--leta-primary); font-size: 21rpx; font-weight: 650; }
.instrument-tool-title { margin-top: 14rpx; font-size: 36rpx; font-weight: 700; }
.instrument-tool-description { margin-top: 12rpx; color: var(--leta-text-secondary); font-size: 24rpx; line-height: 1.55; }
.instrument-open-cta { display: flex; width: 100%; min-height: 86rpx; margin-top: 24rpx; align-items: center; justify-content: center; border-radius: 23rpx; background: var(--leta-primary); color: #fff; font-size: 28rpx; font-weight: 700; text-align: center; box-shadow: 0 8rpx 18rpx rgba(102,82,116,.14); }
.chord-tool-card { min-height: 300rpx; margin-top: 20rpx; background: linear-gradient(145deg, #fff 0%, #f0ebf5 100%); }
.tool-chord { position: relative; flex: none; width: 126rpx; height: 148rpx; margin-left: 22rpx; border-top: 5rpx solid #8b70a1; border-left: 2rpx solid #c5b3d2; border-right: 2rpx solid #c5b3d2; background: repeating-linear-gradient(to bottom, transparent 0, transparent 28rpx, #cfc0d8 29rpx, #cfc0d8 31rpx); }
.tool-chord > view:not(.tool-chord-dot) { position: absolute; top: 0; bottom: 0; width: 2rpx; background: #a08dac; }
.tool-chord > view:nth-child(1) { left: 0; }.tool-chord > view:nth-child(2) { left: 20%; }.tool-chord > view:nth-child(3) { left: 40%; }.tool-chord > view:nth-child(4) { left: 60%; }.tool-chord > view:nth-child(5) { left: 80%; }.tool-chord > view:nth-child(6) { right: 0; }
.tool-chord-dot { position: absolute; z-index: 2; width: 20rpx; height: 20rpx; border: 3rpx solid #fff; border-radius: 50%; background: var(--leta-primary); transform: translate(-50%, -50%); }.tool-chord .dot-one { left: 40%; top: 34%; }.tool-chord .dot-two { left: 60%; top: 56%; }.tool-chord .dot-three { left: 80%; top: 78%; }

.metronome-stage-card,
.metronome-settings-card { box-sizing: border-box; margin-top: 22rpx; padding: 28rpx; border: 2rpx solid var(--leta-border); border-radius: 34rpx; background: rgba(255,255,255,.9); box-shadow: var(--leta-shadow-card); }
.metronome-stage-card { position: relative; text-align: center; background: linear-gradient(180deg, #fff 0%, #faf6fc 100%); overflow: hidden; }
.stage-spark { position: absolute; color: #e7a56e; font-size: 34rpx; opacity: .82; }
.spark-left { left: 58rpx; top: 94rpx; transform: rotate(-12deg); }
.spark-right { right: 54rpx; top: 150rpx; transform: rotate(13deg) scale(.72); }
.mechanical-metronome { position: relative; width: 286rpx; height: 300rpx; margin: 0 auto; }
.metronome-body { position: absolute; left: 28rpx; right: 28rpx; bottom: 15rpx; height: 236rpx; border: 3rpx solid #8c72a1; border-radius: 34rpx 34rpx 28rpx 28rpx; background: linear-gradient(165deg, #e4d7ed 0%, #cbb6dc 58%, #b69aca 100%); clip-path: polygon(30% 0, 70% 0, 100% 100%, 0 100%); box-shadow: inset 0 0 0 8rpx rgba(255,255,255,.16), 0 12rpx 24rpx rgba(102,82,116,.11); }
.metronome-scale { position: absolute; z-index: 2; left: 95rpx; top: 67rpx; display: flex; width: 96rpx; height: 96rpx; flex-direction: column; justify-content: space-between; }
.metronome-scale view { height: 2rpx; border-radius: 99rpx; background: rgba(105,84,119,.36); }
.metronome-scale view:nth-child(2),
.metronome-scale view:nth-child(4) { margin: 0 13rpx; opacity: .68; }
.pendulum-arm { position: absolute; z-index: 4; left: 140rpx; bottom: 60rpx; width: 7rpx; height: 214rpx; border-radius: 99rpx; background: #fffafc; transform: rotate(-24deg); transform-origin: 50% 100%; box-shadow: 0 2rpx 4rpx rgba(92,71,107,.12); }
.pendulum-weight { position: absolute; left: -18rpx; top: 56rpx; width: 43rpx; height: 62rpx; border: 3rpx solid #8c72a1; border-radius: 15rpx; background: #f2b9bb; box-shadow: 0 5rpx 10rpx rgba(102,82,116,.12); }
.pendulum-pivot { position: absolute; z-index: 5; left: 128rpx; bottom: 46rpx; width: 32rpx; height: 32rpx; border: 7rpx solid #fffafc; border-radius: 50%; background: #9a7fb8; }
.metronome-face { position: absolute; z-index: 5; left: 78rpx; bottom: 48rpx; width: 130rpx; height: 66rpx; }
.face-eye { position: absolute; top: 12rpx; width: 9rpx; height: 13rpx; border-radius: 50%; background: #5f506a; }
.face-eye-left { left: 35rpx; }
.face-eye-right { right: 35rpx; }
.face-cheek { position: absolute; top: 31rpx; width: 18rpx; height: 9rpx; border-radius: 50%; background: rgba(224,132,146,.42); }
.face-cheek-left { left: 18rpx; }
.face-cheek-right { right: 18rpx; }
.face-smile { position: absolute; left: 56rpx; top: 28rpx; width: 18rpx; height: 11rpx; border-bottom: 3rpx solid #5f506a; border-radius: 0 0 18rpx 18rpx; }
.metronome-foot { position: absolute; z-index: 1; bottom: 4rpx; width: 65rpx; height: 24rpx; border-radius: 50%; background: #a98bc0; }
.foot-left { left: 46rpx; transform: rotate(-5deg); }
.foot-right { right: 46rpx; transform: rotate(5deg); }
.mechanical-metronome.is-running .pendulum-arm { animation-name: metronome-swing; animation-timing-function: ease-in-out; animation-iteration-count: infinite; animation-direction: alternate; }
@keyframes metronome-swing { from { transform: rotate(-25deg); } to { transform: rotate(25deg); } }

.tempo-reading { display: flex; align-items: baseline; justify-content: center; min-width: 0; margin-top: 8rpx; }
.bpm-number { font-size: 86rpx; font-weight: 720; line-height: 1.05; letter-spacing: -3rpx; font-variant-numeric: tabular-nums; }
.bpm-unit { margin-left: 10rpx; color: var(--leta-text-secondary); font-size: 22rpx; font-weight: 650; }
.tempo-slider-row { display: grid; grid-template-columns: 42rpx minmax(0, 1fr) 42rpx; align-items: center; gap: 8rpx; margin-top: 8rpx; color: var(--leta-text-secondary); font-size: 21rpx; }
.bpm-slider,
.volume-slider { width: 100%; margin: 8rpx 0 0; }
.beat-dots { display: flex; align-items: center; justify-content: center; gap: 18rpx; min-height: 48rpx; margin-top: 8rpx; }
.beat-dot { width: 15rpx; height: 15rpx; border: 2rpx solid var(--leta-instrument); border-radius: 50%; background: #fff; transition: transform 160ms ease, background 160ms ease; }
.beat-dot.accent { width: 20rpx; height: 20rpx; }
.beat-dot.active { border-color: var(--leta-primary); background: var(--leta-primary); transform: scale(1.32); }
.metronome-play { width: 118rpx; height: 118rpx; margin: 8rpx auto 0; border: 0; border-radius: 50%; background: linear-gradient(145deg, #a68abd, #86689f); color: #fff; box-shadow: 0 10rpx 22rpx rgba(102,82,116,.18); }
.play-shape { width: 0; height: 0; margin-left: 7rpx; border-top: 15rpx solid transparent; border-bottom: 15rpx solid transparent; border-left: 24rpx solid #fff; }
.stop-shape { width: 28rpx; height: 28rpx; border-radius: 6rpx; background: #fff; }
.round-pressed { opacity: 0.76; transform: scale(0.97); }
.play-status { display: block; margin-top: 13rpx; color: var(--leta-text-secondary); font-size: 23rpx; }

.metronome-record-card { box-sizing: border-box; margin-top: 22rpx; padding: 26rpx 28rpx; border: 2rpx solid #ddd0e6; border-radius: 34rpx; background: linear-gradient(145deg, #fff 0%, #f5eff8 100%); box-shadow: var(--leta-shadow-card); }
.record-card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.record-card-heading view { display: flex; flex-direction: column; gap: 7rpx; }
.record-card-heading text:first-child { color: var(--leta-text); font-size: 27rpx; font-weight: 700; }
.record-card-heading text:nth-child(2) { color: var(--leta-text-secondary); font-size: 22rpx; line-height: 1.45; }
.record-limit { flex: none; padding: 7rpx 13rpx; border-radius: 999rpx; background: #eee4f4; color: var(--leta-primary); font-size: 20rpx; font-weight: 650; }
.metronome-recording-state { display: flex; min-height: 42rpx; margin-top: 18rpx; align-items: center; gap: 10rpx; color: #a76170; font-size: 23rpx; font-weight: 650; }
.metronome-recording-state view { width: 14rpx; height: 14rpx; border-radius: 50%; background: #c36f7d; box-shadow: 0 0 0 6rpx rgba(195,111,125,.14); animation: record-pulse 1.2s ease-in-out infinite; }
@keyframes record-pulse { 50% { opacity: .48; transform: scale(.82); } }
.metronome-record-button,
.metronome-playback-button { width: 100%; min-height: 88rpx; margin-top: 18rpx; border: 0; border-radius: 23rpx; font-size: 26rpx; font-weight: 700; }
.metronome-record-button { gap: 13rpx; background: var(--leta-primary); color: #fff; box-shadow: 0 8rpx 18rpx rgba(102,82,116,.14); }
.metronome-record-button.recording { background: #a76170; }
.record-start-shape { width: 22rpx; height: 22rpx; border-radius: 50%; background: #fff; }
.record-stop-shape { width: 22rpx; height: 22rpx; border-radius: 5rpx; background: currentColor; }
.metronome-record-button .record-stop-shape { background: #fff; }
.record-stop-shape.small { width: 18rpx; height: 18rpx; }
.metronome-playback-button { justify-content: flex-start; gap: 12rpx; padding: 0 24rpx; background: #fff; color: var(--leta-primary); border: 2rpx solid #d9cae5; }
.metronome-playback-button > text:nth-last-child(1) { margin-left: auto; color: var(--leta-text-secondary); font-size: 21rpx; font-weight: 500; }
.metronome-playback-button.playing { border-color: var(--leta-primary); background: #f1e9f5; }
.record-play-shape { width: 0; height: 0; border-top: 12rpx solid transparent; border-bottom: 12rpx solid transparent; border-left: 19rpx solid currentColor; }
.metronome-playback-progress { display: block; height: 8rpx; margin-top: 14rpx; overflow: hidden; border-radius: 99rpx; }
.record-help { display: block; margin-top: 15rpx; color: var(--leta-text-secondary); font-size: 21rpx; line-height: 1.45; }
.record-pressed { opacity: .76; transform: scale(.98); }

.control-group { margin-top: 26rpx; text-align: left; }
.control-group.first { margin-top: 0; }
.control-label-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.control-label-row > text:last-child { color: var(--leta-text-secondary); font-size: 21rpx; }
.control-label { display: block; color: var(--leta-text); font-size: 25rpx; font-weight: 650; }
.segment-control { display: flex; gap: 8rpx; margin-top: 14rpx; padding: 7rpx; border-radius: 22rpx; background: var(--leta-surface-soft); }
.segment-button { flex: 1; min-width: 0; min-height: 72rpx; padding: 0 6rpx; border: 0; border-radius: 17rpx; background: transparent; color: var(--leta-text-secondary); font-size: 24rpx; }
.rhythm-button { font-family: "Times New Roman", serif; font-size: 34rpx; font-weight: 650; line-height: 1; }
.rhythm-button:first-child { font-family: inherit; font-size: 20rpx; letter-spacing: .5rpx; }
.segment-button.selected { background: #fff; color: var(--leta-primary); font-weight: 700; box-shadow: 0 4rpx 12rpx rgba(68,57,74,.1); }
.segment-pressed { opacity: 0.65; }
.metronome-secondary-settings { margin-top: 28rpx; padding-top: 26rpx; border-top: 2rpx dashed #e5dce9; }
.secondary-settings-title { display: block; color: var(--leta-text-secondary); font-size: 21rpx; font-weight: 650; letter-spacing: 1rpx; }
.sound-group { margin-top: 18rpx; }
.control-row { margin-top: 28rpx; text-align: left; }
.control-copy { display: flex; align-items: center; justify-content: space-between; }
.control-value { color: var(--leta-primary); font-size: 23rpx; font-weight: 650; font-variant-numeric: tabular-nums; }
.count-in-row { width: 100%; min-height: 96rpx; margin-top: 22rpx; padding: 0 4rpx; justify-content: space-between; border: 0; background: transparent; color: var(--leta-text); text-align: left; }
.count-in-copy { display: flex; flex-direction: column; gap: 6rpx; }
.count-in-copy text:first-child { font-size: 26rpx; font-weight: 650; }
.count-in-copy text:last-child { color: var(--leta-text-secondary); font-size: 22rpx; }
.toggle { position: relative; flex: none; width: 88rpx; height: 50rpx; border-radius: 999rpx; background: #d5ced8; transition: background 180ms ease; }
.toggle view { position: absolute; left: 6rpx; top: 6rpx; width: 38rpx; height: 38rpx; border-radius: 50%; background: #fff; box-shadow: 0 3rpx 8rpx rgba(68,57,74,.18); transition: transform 180ms ease; }
.toggle.on { background: var(--leta-primary); }
.toggle.on view { transform: translateX(38rpx); }

.progress-card { background: linear-gradient(145deg, #fff 0%, var(--leta-theory-soft) 100%); }
.progress-row { display: flex; align-items: center; justify-content: space-between; font-size: 28rpx; font-weight: 650; }
.progress-number { color: #805c12; font-variant-numeric: tabular-nums; }
.progress-track { height: 18rpx; margin-top: 24rpx; border-radius: 999rpx; background: rgba(68, 57, 74, 0.12); overflow: hidden; }
.progress-value { height: 100%; border-radius: inherit; background: var(--leta-theory); }
.progress-level-0 { width: 0; }
.progress-level-1 { width: 12.5%; }
.progress-level-2 { width: 25%; }
.progress-level-3 { width: 37.5%; }
.progress-level-4 { width: 50%; }
.progress-level-5 { width: 62.5%; }
.progress-level-6 { width: 75%; }
.progress-level-7 { width: 87.5%; }
.progress-level-8 { width: 100%; }

.course-card { min-height: 128rpx; }
.course-number { display: flex; align-items: center; justify-content: center; flex: none; width: 72rpx; height: 72rpx; border-radius: 22rpx; background: var(--leta-theory-soft); color: #805c12; font-size: 26rpx; font-weight: 700; }

.lesson-path,
.progress-list,
.settings-card {
  overflow: hidden;
  border: 2rpx solid var(--leta-border);
  border-radius: 28rpx;
  background: var(--leta-surface);
  box-shadow: var(--leta-shadow-card);
}

.path-item { position: relative; display: flex; align-items: center; min-height: 104rpx; padding: 16rpx 22rpx; }
.path-item::after { content: ""; position: absolute; left: 49rpx; top: 76rpx; bottom: -28rpx; width: 2rpx; background: var(--leta-border); }
.path-item:last-child::after { display: none; }
.path-dot { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; flex: none; width: 52rpx; height: 52rpx; margin-right: 18rpx; border: 2rpx solid var(--leta-border); border-radius: 50%; background: var(--leta-surface-soft); color: var(--leta-text-secondary); font-size: 22rpx; font-weight: 700; }
.path-item.complete .path-dot { background: var(--leta-instrument-soft); color: var(--leta-success); }
.path-item.current .path-dot { border-color: var(--leta-primary); background: var(--leta-practice-soft); color: var(--leta-primary); }
.path-item > view:last-child { display: flex; flex-direction: column; gap: 5rpx; }
.path-item > view:last-child text:first-child { font-size: 27rpx; font-weight: 600; }
.path-item > view:last-child text:last-child { color: var(--leta-text-secondary); font-size: 23rpx; }

.today-card { background: linear-gradient(145deg, var(--leta-practice-soft), #fff); }
.today-label { color: #554b87; background: rgba(255,255,255,0.78); }
.today-title { display: block; margin-top: 24rpx; font-size: 36rpx; font-weight: 700; }
.today-copy { display: block; margin-top: 10rpx; color: var(--leta-text-secondary); font-size: 26rpx; line-height: 1.55; }

.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.quick-card { min-height: 206rpx; padding: 24rpx; align-items: flex-start; flex-direction: column; border: 2rpx solid var(--leta-border); border-radius: 28rpx; color: var(--leta-text); box-shadow: var(--leta-shadow-card); text-align: left; transition: opacity 180ms ease, transform 180ms ease; }
.quick-sing { background: var(--leta-sing-soft); }
.quick-mint { background: var(--leta-instrument-soft); }
.quick-card > text:nth-of-type(1) { margin-top: 18rpx; font-size: 28rpx; font-weight: 650; }
.quick-card > text:nth-of-type(2) { margin-top: 5rpx; color: var(--leta-text-secondary); font-size: 23rpx; }
.quick-icon { position: relative; width: 56rpx; height: 56rpx; border-radius: 18rpx; background: rgba(255,255,255,0.72); }
.scale-icon view { position: absolute; left: 12rpx; top: 25rpx; width: 6rpx; height: 14rpx; border-radius: 99rpx; background: var(--leta-text); box-shadow: 10rpx -12rpx 0 var(--leta-text), 20rpx -4rpx 0 var(--leta-text), 30rpx -20rpx 0 var(--leta-text); }
.tempo-icon view { position: absolute; left: 17rpx; top: 10rpx; width: 20rpx; height: 33rpx; border: 3rpx solid var(--leta-text); border-radius: 50% 50% 40% 40%; }
.tempo-icon view::after { content: ""; position: absolute; left: 8rpx; top: 5rpx; width: 3rpx; height: 21rpx; border-radius: 99rpx; background: var(--leta-text); transform: rotate(12deg); transform-origin: bottom; }

.book-icon { background: var(--leta-theory-soft); }
.book-icon view { width: 38rpx; height: 34rpx; border: 3rpx solid var(--leta-text); border-radius: 6rpx; }

.empty-card { display: flex; align-items: center; min-height: 112rpx; padding: 18rpx 24rpx; border: 2rpx dashed var(--leta-border); border-radius: 28rpx; background: rgba(255,255,255,0.64); color: var(--leta-text-secondary); font-size: 25rpx; }
.tiny-note { position: relative; flex: none; width: 62rpx; height: 62rpx; margin-right: 18rpx; border-radius: 20rpx; background: var(--leta-practice-soft); }
.tiny-note::before { content: ""; position: absolute; left: 30rpx; top: 12rpx; width: 20rpx; height: 24rpx; border-left: 4rpx solid var(--leta-primary); border-top: 4rpx solid var(--leta-primary); transform: skewY(-12deg); }
.tiny-note::after,
.tiny-note view { content: ""; position: absolute; bottom: 11rpx; width: 15rpx; height: 11rpx; border: 3rpx solid var(--leta-primary); border-radius: 50%; }
.tiny-note::after { left: 13rpx; }
.tiny-note view { right: 5rpx; bottom: 15rpx; }

.stats-card { display: flex; margin-top: 40rpx; padding: 30rpx 8rpx; border: 2rpx solid var(--leta-border); border-radius: 32rpx; background: var(--leta-practice-soft); box-shadow: var(--leta-shadow-card); }
.stats-card > view { flex: 1; text-align: center; border-right: 2rpx solid rgba(117, 106, 138, 0.12); }
.stats-card > view:last-child { border-right: 0; }
.stat-number { display: block; font-size: 42rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.stat-label { display: block; margin-top: 7rpx; color: var(--leta-text-secondary); font-size: 23rpx; }

.progress-list > view { display: flex; align-items: center; min-height: 92rpx; padding: 0 24rpx; border-bottom: 2rpx solid var(--leta-surface-soft); font-size: 26rpx; }
.progress-list > view:last-child { border-bottom: 0; }
.list-dot { flex: none; width: 16rpx; height: 16rpx; margin-right: 14rpx; border-radius: 50%; }
.dot-sing { background: var(--leta-sing); }
.dot-mint { background: var(--leta-instrument); }
.dot-yellow { background: var(--leta-theory); }
.list-value { margin-left: auto; color: var(--leta-text-secondary); font-size: 24rpx; }

.settings-card button { width: 100%; min-height: 96rpx; padding: 0 24rpx; justify-content: flex-start; border: 0; border-bottom: 2rpx solid var(--leta-surface-soft); border-radius: 0; background: transparent; color: var(--leta-text); font-size: 26rpx; text-align: left; }
.settings-card button:last-child { border-bottom: 0; }
.setting-value { margin-left: auto; color: var(--leta-text-secondary); font-size: 24rpx; }
.setting-pressed { background: var(--leta-surface-soft) !important; }

.tabbar {
  position: fixed;
  z-index: 20;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(12rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 8rpx;
  border: 2rpx solid var(--leta-border);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 36rpx rgba(68, 57, 74, 0.14);
}

.tab-item { position: relative; flex: 1; height: 96rpx; flex-direction: column; border: 0; border-radius: 24rpx; background: transparent; }
.tab-bubble { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 22rpx; transition: background 180ms ease, transform 180ms ease; }
.tab-item.active .tab-bubble { background: var(--leta-primary-soft); }
.tab-item.sing.active .tab-bubble { background: var(--leta-primary-soft); }
.tab-item.instrument.active .tab-bubble { background: var(--leta-primary-soft); }
.tab-item.theory.active .tab-bubble { background: var(--leta-theory-soft); }
.tab-item.practice.active .tab-bubble,
.tab-item.me.active .tab-bubble { background: var(--leta-practice-soft); }
.tab-pressed { opacity: 0.62; }
.tab-item.disabled { opacity: 0.58; }
.active-dot { position: absolute; bottom: 4rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--leta-primary); opacity: 0; }
.tab-item.active .active-dot { opacity: 1; }

.nav-image { display: block; width: 48rpx; height: 48rpx; opacity: .72; transition: opacity 180ms ease, transform 180ms ease; }
.tab-item.active .nav-image { opacity: 1; transform: scale(1.06); }
.tab-item.disabled .nav-image { filter: grayscale(.18); }

@media (max-height: 680px) {
  .page-content { padding-top: 28rpx; }
  .feature-card,
  .today-card,
  .metronome-stage-card,
  .metronome-settings-card,
  .progress-card { margin-top: 30rpx; }
}

@media (min-width: 600px) {
  .page-content { max-width: 760rpx; margin: 0 auto; padding-left: 40rpx; padding-right: 40rpx; }
  .tabbar { left: 50%; right: auto; width: 700rpx; transform: translateX(-50%); }
}

@media (orientation: landscape) {
  .content { height: calc(100vh - 118rpx - env(safe-area-inset-bottom)); }
  .page-content { max-width: 720rpx; margin: 0 auto; }
  .tabbar { height: 96rpx; }
  .tab-item { height: 88rpx; }
}
