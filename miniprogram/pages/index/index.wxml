<view class="page-shell">
  <scroll-view class="content" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{activeTab}}">
    <view wx:if="{{activeTab === 'sing'}}" id="sing" class="page-content">
      <view class="feature-card feature-sing">
        <view class="feature-copy-block">
          <view class="feature-badge">声音练习</view>
          <text class="feature-title">音阶跟练</text>
          <text class="feature-copy">边唱边看音高轨迹，偏高偏低都说清楚</text>
        </view>
        <button class="primary-button" bindtap="startSinging" hover-class="is-pressed">开始练习</button>
      </view>

      <view class="section-heading">
        <text class="section-title">换一种练法</text>
      </view>
      <view class="secondary-actions">
        <button class="single-note-card" bindtap="startSingle" hover-class="card-pressed" aria-label="开始单音模唱">
          <view class="single-note-icon" aria-hidden="true"><view class="note-orbit"></view><view class="note-core"></view></view>
          <view class="single-note-copy"><text>单音模唱</text><text>专注一个目标音，更容易找到位置</text></view>
          <view class="chevron" aria-hidden="true"></view>
        </button>
      </view>
    </view>

    <view wx:if="{{activeTab === 'instrument'}}" id="instrument" class="page-content">
      <block wx:if="{{instrumentView === 'home'}}">
        <view class="instrument-home-heading">
          <text class="instrument-home-title">乐器</text>
          <text class="instrument-home-subtitle">练习工具</text>
        </view>

        <button class="instrument-tool-card" bindtap="openMetronome" hover-class="card-pressed" aria-label="打开节拍器">
          <view class="instrument-card-main">
            <view class="instrument-tool-copy">
              <text class="instrument-tool-kicker">节奏练习</text>
              <text class="instrument-tool-title">节拍器</text>
              <text class="instrument-tool-description">调节速度和拍号，找到稳定的拍子</text>
            </view>
            <view class="tool-metronome" aria-hidden="true">
              <view class="tool-metronome-body"></view>
              <view class="tool-metronome-arm"></view>
              <view class="tool-metronome-pivot"></view>
              <view class="tool-metronome-eye eye-left"></view>
              <view class="tool-metronome-eye eye-right"></view>
              <view class="tool-metronome-smile"></view>
            </view>
          </view>
          <view class="instrument-open-cta">打开节拍器</view>
        </button>
      </block>

      <block wx:else>
        <view class="metronome-detail-heading">
          <button class="detail-back" bindtap="backToInstrumentHome" hover-class="round-pressed" aria-label="返回乐器工具"><view></view></button>
          <text>节拍器</text>
          <view class="detail-heading-spacer"></view>
        </view>

        <view class="metronome-stage-card">
          <view class="stage-spark spark-left" aria-hidden="true">✦</view>
          <view class="stage-spark spark-right" aria-hidden="true">✦</view>
          <view class="mechanical-metronome {{metronomePlaying || countInActive ? 'is-running' : ''}}" aria-label="机械节拍器摆杆动画">
            <view class="metronome-scale"><view></view><view></view><view></view><view></view><view></view></view>
            <view class="metronome-body"></view>
            <view class="pendulum-arm" style="animation-duration:{{pendulumDuration}}ms;"><view class="pendulum-weight"></view></view>
            <view class="pendulum-pivot"></view>
            <view class="metronome-face" aria-hidden="true">
              <view class="face-eye face-eye-left"></view>
              <view class="face-eye face-eye-right"></view>
              <view class="face-cheek face-cheek-left"></view>
              <view class="face-cheek face-cheek-right"></view>
              <view class="face-smile"></view>
            </view>
            <view class="metronome-foot foot-left"></view>
            <view class="metronome-foot foot-right"></view>
          </view>
          <view class="tempo-reading">
            <text class="bpm-number">{{bpm}}</text><text class="bpm-unit">BPM</text>
          </view>
          <view class="tempo-slider-row">
            <text>慢</text>
            <slider class="bpm-slider" min="40" max="240" step="1" value="{{bpm}}" activeColor="#9A7FB8" backgroundColor="#E8E0EB" block-color="#FFFFFF" block-size="24" bindchanging="changeBpmFromSlider" bindchange="commitBpm" aria-label="调节节拍速度"></slider>
            <text>快</text>
          </view>

          <view class="beat-dots" aria-label="当前第 {{beat}} 拍">
            <view wx:for="{{beatOptions}}" wx:key="*this" class="beat-dot {{beat === item ? 'active' : ''}} {{item === 1 ? 'accent' : ''}}"></view>
          </view>

          <button class="metronome-play" bindtap="toggleMetronome" hover-class="round-pressed" aria-label="{{metronomePlaying || countInActive ? '暂停节拍器' : '启动节拍器'}}">
            <view class="{{metronomePlaying || countInActive ? 'stop-shape' : 'play-shape'}}"></view>
          </button>
          <text class="play-status">{{countInActive ? '预备 ' + countInCountdown : (metronomePlaying ? '正在播放 · 第 ' + beat + ' 拍' : '点击开始')}}</text>
        </view>

        <view class="metronome-settings-card">
          <view class="control-group first">
            <text class="control-label">拍号</text>
            <view class="segment-control signature-control">
              <button wx:for="{{timeSignatures}}" wx:key="label" class="segment-button {{timeSignature === item.label ? 'selected' : ''}}" data-label="{{item.label}}" data-beats="{{item.beats}}" bindtap="selectTimeSignature" hover-class="segment-pressed">{{item.label}}</button>
            </view>
          </view>

          <view class="control-group">
            <text class="control-label">节拍音色</text>
            <view class="segment-control tone-control">
              <button wx:for="{{toneOptions}}" wx:key="key" class="segment-button {{metronomeTone === item.key ? 'selected' : ''}}" data-tone="{{item.key}}" bindtap="selectTone" hover-class="segment-pressed">{{item.label}}</button>
            </view>
          </view>

          <view class="control-row">
            <view class="control-copy"><text class="control-label">节拍音量</text><text class="control-value">{{metronomeVolume}}%</text></view>
            <slider class="volume-slider" min="0" max="100" step="1" value="{{metronomeVolume}}" activeColor="#9A7FB8" backgroundColor="#E8E0EB" block-color="#FFFFFF" block-size="22" bindchanging="changeVolume" bindchange="changeVolume" aria-label="调节节拍音量"></slider>
          </view>

          <button class="count-in-row" bindtap="toggleCountIn" hover-class="setting-pressed" aria-label="{{countInEnabled ? '关闭预备拍' : '开启预备拍'}}">
            <view class="count-in-copy"><text>预备拍</text><text>开始前先倒数一小节</text></view>
            <view class="toggle {{countInEnabled ? 'on' : ''}}"><view></view></view>
          </button>
        </view>
      </block>
    </view>

    <view wx:if="{{activeTab === 'theory'}}" id="theory" class="page-content">
      <view class="page-heading">
        <view class="heading-copy">
          <view class="eyebrow theory-tone"><view class="eyebrow-dot"></view>零基础乐理</view>
          <view class="page-title">把知识搭成<text class="marker marker-yellow">小积木</text></view>
          <view class="page-subtitle">一次只学一个概念，听懂了再往前走。</view>
        </view>
      </view>

      <view class="progress-card">
        <view class="progress-row"><text>我的学习进度</text><text class="progress-number">{{theoryProgress}} / 8</text></view>
        <view class="progress-track" aria-label="乐理课程完成 {{theoryProgress}} 节，共 8 节"><view class="progress-value" style="width: {{theoryProgress / 8 * 100}}%;"></view></view>
        <button class="primary-button compact" bindtap="continueLesson" hover-class="is-pressed">继续学习</button>
      </view>

      <view class="section-heading"><text class="section-title">今天学一点</text><text class="section-hint">约 3 分钟</text></view>
      <button class="course-card" bindtap="continueLesson" hover-class="card-pressed" aria-label="学习第三课半音和全音">
        <view class="course-number">03</view>
        <view class="course-info"><text class="course-title">半音和全音</text><text class="course-copy">听一听相邻音之间的距离</text></view>
        <view class="chevron" aria-hidden="true"></view>
      </button>

      <view class="section-heading"><text class="section-title">学习地图</text><text class="section-hint">基础认识</text></view>
      <view class="lesson-path">
        <view class="path-item complete"><view class="path-dot">✓</view><view><text>认识音名</text><text>音符也有自己的名字</text></view></view>
        <view class="path-item complete"><view class="path-dot">✓</view><view><text>什么是音高</text><text>听见声音的高与低</text></view></view>
        <view class="path-item current"><view class="path-dot">3</view><view><text>半音和全音</text><text>正在学习</text></view></view>
        <view class="path-item"><view class="path-dot">4</view><view><text>音阶是什么</text><text>完成上一课后解锁</text></view></view>
      </view>
    </view>

    <view wx:if="{{activeTab === 'practice'}}" id="practice" class="page-content">
      <view class="page-heading">
        <view class="heading-copy">
          <view class="eyebrow practice-tone"><view class="eyebrow-dot"></view>今日练习</view>
          <view class="page-title">和音乐<text class="marker marker-lavender">待一会儿</text></view>
          <view class="page-subtitle">不追求一次唱好，今天开始就很好。</view>
        </view>
      </view>

      <view class="today-card">
        <view class="today-label">今日推荐 · 约 5 分钟</view>
        <text class="today-title">从 C3 音阶开始</text>
        <text class="today-copy">先听范音，再跟着音高轨迹唱一遍。</text>
        <button class="primary-button" bindtap="startSinging" hover-class="is-pressed">开始今日练习</button>
      </view>

      <view class="section-heading"><text class="section-title">快速开始</text><text class="section-hint">选一个就好</text></view>
      <view class="quick-grid">
        <button class="quick-card quick-sing" bindtap="startSinging" hover-class="card-pressed"><view class="quick-icon scale-icon" aria-hidden="true"><view></view></view><text>音阶跟练</text><text>练声音</text></button>
        <button class="quick-card quick-mint" bindtap="openMetronome" hover-class="card-pressed"><view class="quick-icon tempo-icon" aria-hidden="true"><view></view></view><text>节拍器</text><text>稳节奏</text></button>
      </view>

      <view class="section-heading"><text class="section-title">继续学习</text></view>
      <button class="lesson-card" bindtap="continueLesson" hover-class="card-pressed" aria-label="继续乐理入门">
        <view class="book-icon" aria-hidden="true"><view></view></view>
        <view class="lesson-info"><text class="lesson-title">乐理入门</text><text class="lesson-copy">第 {{theoryProgress}} 课 · 半音和全音</text></view>
        <view class="chevron" aria-hidden="true"></view>
      </button>

      <view class="section-heading"><text class="section-title">最近记录</text></view>
      <view class="empty-card"><view class="tiny-note" aria-hidden="true"><view></view></view><text>{{practiceMinutes > 0 ? '已经和音乐待了 ' + practiceMinutes + ' 分钟' : '第一次练习后，这里会留下脚印'}}</text></view>
    </view>

    <view wx:if="{{activeTab === 'me'}}" id="me" class="page-content">
      <view class="page-heading">
        <view class="heading-copy">
          <view class="eyebrow me-tone"><view class="eyebrow-dot"></view>我的成长</view>
          <view class="page-title">每一点进步都<text class="marker marker-lavender">值得记住</text></view>
          <view class="page-subtitle">不用比较，只看见自己的变化。</view>
        </view>
      </view>

      <view class="stats-card">
        <view><text class="stat-number">{{practiceMinutes}}</text><text class="stat-label">练习分钟</text></view>
        <view><text class="stat-number">{{practiceDays}}</text><text class="stat-label">练习天数</text></view>
        <view><text class="stat-number">{{theoryProgress}}</text><text class="stat-label">学习课程</text></view>
      </view>

      <view class="section-heading"><text class="section-title">我的进度</text></view>
      <view class="progress-list">
        <view><view class="list-dot dot-sing"></view><text>唱 · 音阶跟练</text><text class="list-value">{{practiceMinutes > 0 ? '已开始' : '去练习'}}</text></view>
        <view><view class="list-dot dot-mint"></view><text>乐器 · 节拍器</text><text class="list-value">可使用</text></view>
        <view><view class="list-dot dot-yellow"></view><text>乐理 · 基础认识</text><text class="list-value">{{theoryProgress}} / 8</text></view>
      </view>

      <view class="section-heading"><text class="section-title">设置</text></view>
      <view class="settings-card">
        <button bindtap="showSetting" data-key="audio" hover-class="setting-pressed"><text>音频设置</text><view class="chevron"></view></button>
        <button bindtap="showSetting" data-key="feedback" hover-class="setting-pressed"><text>反馈偏好</text><text class="setting-value">{{feedbackMode}}</text><view class="chevron"></view></button>
        <button bindtap="showSetting" data-key="about" hover-class="setting-pressed"><text>关于乐搭</text><view class="chevron"></view></button>
      </view>
    </view>
  </scroll-view>

  <view class="tabbar" aria-label="主导航">
    <button wx:for="{{tabs}}" wx:key="key" class="tab-item {{activeTab === item.key ? 'active ' + item.key : ''}} {{item.key === 'theory' || item.key === 'practice' || item.key === 'me' ? 'disabled' : ''}}" data-key="{{item.key}}" bindtap="switchTab" hover-class="tab-pressed" aria-label="{{item.key === 'theory' ? item.label + '，开放中' : (item.key === 'practice' || item.key === 'me' ? item.label + '，开发中' : item.label)}}">
      <view class="tab-bubble">
        <image class="nav-image" src="{{item.icon}}" mode="aspectFit" aria-hidden="true"></image>
      </view>
      <view class="active-dot"></view>
    </button>
  </view>
</view>
