page{background:#fff8ed;color:#3d3966;font-family:"Arial Rounded MT Bold","PingFang SC",sans-serif}button{box-sizing:border-box;margin:0;padding:0;display:flex;align-items:center;justify-content:center;line-height:1.2;border:0;font-family:inherit}button::after{display:none}.page{position:relative;min-height:100vh;padding:36rpx 36rpx calc(50rpx + env(safe-area-inset-bottom));box-sizing:border-box;overflow:hidden;background:linear-gradient(180deg,#fff9ef,#fff2e7)}.page-confetti{position:absolute;opacity:.65;pointer-events:none}.confetti-a{right:30rpx;top:300rpx;width:24rpx;height:24rpx;border:6rpx solid #ffd25c;transform:rotate(22deg)}.confetti-b{left:-12rpx;top:530rpx;width:58rpx;height:16rpx;border-radius:99rpx;background:#8adbb8;transform:rotate(-28deg)}.setup,.practice,.finished{position:relative;z-index:2}.setup-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.setup-heading>view:first-child{flex:1}.eyebrow{display:inline-flex;align-items:center;gap:9rpx;min-height:42rpx;padding:0 17rpx;border:3rpx solid #3d3966;border-radius:999rpx;background:#ffe3dc;color:#d85f58;font-size:21rpx;font-weight:800;box-shadow:4rpx 4rpx 0 #3d3966}.eyebrow-dot{width:12rpx;height:12rpx;border-radius:50%;background:#ef766a}.title{font-size:47rpx;font-weight:800;line-height:1.3}.setup .title{margin-top:25rpx}.subtitle{color:#706c88;font-family:"PingFang SC",sans-serif;font-size:25rpx;line-height:1.55;margin-top:12rpx}.sing-buddy{position:relative;flex:none;width:90rpx;height:76rpx;margin-top:4rpx;border:4rpx solid #3d3966;border-radius:44% 56% 48% 52%;background:#ff9682;box-shadow:6rpx 7rpx 0 #3d3966;transform:rotate(6deg)}.buddy-eye{position:absolute;top:26rpx;width:8rpx;height:11rpx;border-radius:50%;background:#3d3966}.buddy-eye.left{left:26rpx}.buddy-eye.right{right:26rpx}.buddy-mouth{position:absolute;left:35rpx;top:42rpx;width:19rpx;height:9rpx;border-bottom:4rpx solid #3d3966;border-radius:0 0 20rpx 20rpx}
.setup-card{position:relative;margin-top:48rpx;padding:40rpx 30rpx 32rpx;border:4rpx solid #3d3966;border-radius:34rpx;background:#fff;box-shadow:9rpx 10rpx 0 #3d3966}.card-tape{position:absolute;left:50%;top:-17rpx;width:110rpx;height:34rpx;background:#ffd96f;border:3rpx solid #3d3966;transform:translateX(-50%) rotate(-2deg)}.label{display:block;color:#514d70;font-size:24rpx;font-weight:800;margin-bottom:17rpx}.note-scroll{width:100%;margin-bottom:35rpx}.note-row{display:flex;gap:13rpx;width:max-content;padding-bottom:4rpx}.note-name-row{display:grid;grid-template-columns:repeat(4,1fr);width:100%}.note-name-row .note-choice{min-width:0}.note-choice{display:flex;align-items:center;justify-content:center;min-width:100rpx;min-height:74rpx;padding:0 12rpx;border:3rpx solid #3d3966;border-radius:19rpx;background:#f4f0f5;font-size:23rpx;box-shadow:0 4rpx 0 #3d3966;box-sizing:border-box}.note-choice.selected{background:#ff9a86;color:#3d3966;font-weight:800;transform:translateY(2rpx);box-shadow:0 2rpx 0 #3d3966}.selected-note{display:flex;align-items:center;justify-content:center;min-height:70rpx;margin:29rpx 0 25rpx;border:3rpx dashed #9a94b1;border-radius:20rpx;background:#fff8ed;color:#716d89;font-size:23rpx}.selected-note text{margin-left:8rpx;color:#3d3966;font-size:30rpx;font-weight:800}.demo-row{width:100%;min-height:112rpx;display:flex;align-items:center;justify-content:flex-start;padding:14rpx 17rpx;border:3rpx solid #3d3966;border-radius:24rpx;background:#fff0b8;color:#3d3966;text-align:left;box-shadow:0 5rpx 0 #3d3966}.demo-pressed{transform:translateY(3rpx);box-shadow:0 2rpx 0 #3d3966}.demo-button{flex:none;display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;border:3rpx solid #3d3966;border-radius:50%;background:#ff9581}.play-shape{width:0;height:0;margin-left:5rpx;border-top:12rpx solid transparent;border-bottom:12rpx solid transparent;border-left:19rpx solid #3d3966}.stop-shape{width:22rpx;height:22rpx;border-radius:4rpx;background:#3d3966}.demo-content{min-width:0;margin-left:17rpx}.demo-title{display:block;font-size:25rpx;font-weight:800}.demo-copy{display:block;margin-top:6rpx;color:#6d6884;font-family:"PingFang SC",sans-serif;font-size:20rpx}.primary{width:100%;min-height:92rpx;margin-top:34rpx;border:4rpx solid #3d3966;border-radius:24rpx;background:#7f6edd;color:#fff;font-size:27rpx;font-weight:800;box-shadow:0 7rpx 0 #3d3966;transition:transform .12s ease,box-shadow .12s ease}.primary[disabled]{background:#aaa4c5;color:#fff;box-shadow:0 4rpx 0 #3d3966}.button-pressed{transform:translateY(5rpx);box-shadow:0 2rpx 0 #3d3966}.permission-hint{display:block;text-align:center;margin-top:18rpx;color:#77738d;font-family:"PingFang SC",sans-serif;font-size:20rpx}.setup-error{display:block;text-align:center;margin-top:12rpx;color:#d95d55;font-family:"PingFang SC",sans-serif;font-size:20rpx}
.practice{text-align:center;padding-top:4rpx}.record-state{display:inline-flex;align-items:center;justify-content:center;gap:11rpx;min-height:56rpx;padding:0 18rpx;margin-bottom:22rpx;border:3rpx solid #3d3966;border-radius:999rpx;background:#fff;color:#6f6b86;font-size:21rpx;box-shadow:3rpx 4rpx 0 #3d3966}.record-state.recording{background:#ffe3dc;color:#b94e49}.record-time{min-width:48rpx;color:#615d7b;font-variant-numeric:tabular-nums}.record-dot{width:15rpx;height:15rpx;border:3rpx solid #3d3966;border-radius:50%;background:#c7c2ce}.recording .record-dot{background:#ff7369;box-shadow:0 0 0 7rpx rgba(255,115,105,.18)}.current-reading{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7rpx}.reading-caption{color:#74708a;font-family:"PingFang SC",sans-serif;font-size:20rpx}.note{font-size:74rpx;font-weight:800;line-height:1.08;text-shadow:4rpx 4rpx 0 #ffd9cf}.target-chip{margin-top:4rpx;padding:9rpx 18rpx;border:3rpx solid #3d3966;border-radius:999rpx;background:#dff7ec;color:#356f60;font-size:20rpx;font-weight:800}.status-label{min-height:40rpx;margin-top:7rpx;font-size:27rpx;font-weight:800}.status-label.good{color:#277b66}.status-label.off,.status-label.error{color:#d95d55}.status-label.listening{color:#5d577e}.pitch-number{min-height:30rpx;font-family:"PingFang SC",sans-serif;font-size:21rpx;color:#716d88;font-variant-numeric:tabular-nums}.input-meter{height:15rpx;margin:21rpx 0 16rpx;border:3rpx solid #3d3966;border-radius:999rpx;background:#fff;overflow:hidden}.input-meter-fill{height:100%;border-radius:999rpx;background:#82d9b5;transition:width .18s ease}.pitch-chart{position:relative;width:100%;height:560rpx;border:4rpx solid #3d3966;border-radius:30rpx;background:#37345e;box-shadow:8rpx 9rpx 0 #3d3966;overflow:hidden}.chart-line{position:absolute;left:0;right:0;height:1rpx;background:#57537b}.chart-line.major{height:2rpx;background:#827da5}.chart-line text{position:absolute;left:13rpx;top:-23rpx;color:#aaa5c4;font-size:17rpx;line-height:24rpx}.chart-line.major text{color:#fff8ed;font-weight:700}.pitch-segment{position:absolute;height:7rpx;border:2rpx solid #3d3966;border-radius:999rpx;background:#ff8f7d;transform-origin:left center;box-shadow:0 0 10rpx rgba(255,143,125,.4)}.pitch-dot{position:absolute;width:16rpx;height:16rpx;border:4rpx solid #fff;border-radius:50%;background:#ffd45f;transform:translate(-50%,-50%);box-shadow:0 0 0 7rpx rgba(255,212,95,.2)}.chart-empty{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22rpx;color:#dedaf0;font-family:"PingFang SC",sans-serif;font-size:21rpx}.waveform-preview{display:flex;align-items:center;justify-content:center;gap:4rpx;width:76%;height:112rpx}.waveform-preview view{flex:1;min-width:3rpx;max-width:8rpx;border-radius:999rpx;background:#82d9b5;box-shadow:0 0 6rpx rgba(130,217,181,.3)}.chart-empty-pulse{position:relative;width:24rpx;height:24rpx;border:4rpx solid #fff;border-radius:50%;background:#82d9b5;box-shadow:0 0 0 12rpx rgba(130,217,181,.16)}.chart-empty-pulse::before,.chart-empty-pulse::after{content:"";position:absolute;top:6rpx;width:4rpx;height:5rpx;border-radius:50%;background:#3d3966}.chart-empty-pulse::before{left:5rpx}.chart-empty-pulse::after{right:5rpx}.chart-legend{display:flex;justify-content:space-between;margin-top:16rpx;color:#6e6a84;font-family:"PingFang SC",sans-serif;font-size:18rpx}.progress{height:15rpx;margin-top:24rpx;border:3rpx solid #3d3966;border-radius:999rpx;background:#fff;overflow:hidden}.progress view{height:100%;background:#ffd45f;border-radius:999rpx}.bottom-actions{display:flex;gap:18rpx;margin-top:25rpx}.bottom-actions button{flex:1;min-height:88rpx;border:4rpx solid #3d3966;border-radius:22rpx;background:#fff;color:#3d3966;font-size:24rpx;font-weight:800;box-shadow:0 6rpx 0 #3d3966}.bottom-actions .pause{background:#ff9a86}.action-pressed{transform:translateY(4rpx);box-shadow:0 2rpx 0 #3d3966!important}
.finished{text-align:center;padding-top:90rpx}.finish-mark{position:relative;margin:0 auto 40rpx;width:126rpx;height:108rpx;border:4rpx solid #3d3966;border-radius:47% 53% 44% 56%;background:#82d9b5;box-shadow:8rpx 9rpx 0 #3d3966;transform:rotate(-3deg)}.finish-eye{position:absolute;top:38rpx;width:10rpx;height:13rpx;border-radius:50%;background:#3d3966}.finish-eye.left{left:37rpx}.finish-eye.right{right:37rpx}.finish-smile{position:absolute;left:49rpx;top:61rpx;width:27rpx;height:13rpx;border-bottom:5rpx solid #3d3966;border-radius:0 0 30rpx 30rpx}.finished .title{max-width:620rpx;margin:0 auto}.summary{display:flex;margin-top:52rpx;padding:28rpx 0;border:4rpx solid #3d3966;border-radius:28rpx;background:#d8ccff;box-shadow:7rpx 8rpx 0 #3d3966}.summary view{flex:1;border-right:3rpx dashed rgba(61,57,102,.25)}.summary view:last-child{border:0}.summary text{display:block}.summary text:first-child{font-size:29rpx;font-weight:800}.summary text:last-child{margin-top:9rpx;color:#625e7a;font-family:"PingFang SC",sans-serif;font-size:19rpx}.ghost{width:100%;min-height:80rpx;margin-top:19rpx;border:3rpx solid transparent;border-radius:20rpx;background:transparent;color:#68647f;font-size:24rpx;font-weight:700}.ghost-pressed{background:#eee8ff}
@media (min-width:600px){.setup,.practice,.finished{max-width:720rpx;margin:0 auto}}
@media (prefers-reduced-motion:reduce){.primary,.input-meter-fill{transition:none}}
