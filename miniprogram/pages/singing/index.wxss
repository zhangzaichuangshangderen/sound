.page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #fbf9fb 0%, var(--leta-bg) 100%);
}

.setup,
.practice,
.finished { position: relative; z-index: 2; }

.setup-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 22rpx; }
.setup-heading > view:first-child { flex: 1; min-width: 0; }
.eyebrow { display: inline-flex; align-items: center; gap: 10rpx; min-height: 48rpx; padding: 0 18rpx; border: 2rpx solid var(--leta-border); border-radius: 999rpx; background: var(--leta-sing-soft); color: #a84638; font-size: 24rpx; font-weight: 600; }
.eyebrow-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--leta-sing); }
.title { font-size: 44rpx; font-weight: 700; line-height: 1.32; letter-spacing: -1rpx; }
.setup .title { margin-top: 22rpx; }
.subtitle { margin-top: 10rpx; color: var(--leta-text-secondary); font-size: 27rpx; line-height: 1.6; }

.setup-card { position: relative; box-sizing: border-box; margin-top: 40rpx; padding: 34rpx 28rpx 30rpx; border: 2rpx solid var(--leta-border); border-radius: 32rpx; background: var(--leta-surface); box-shadow: var(--leta-shadow-card); }
.label { display: block; margin-bottom: 16rpx; color: var(--leta-text); font-size: 27rpx; font-weight: 650; }
.note-row { padding: 2rpx 0 6rpx; }
.note-grid { display: flex; flex-wrap: wrap; gap: 12rpx; box-sizing: border-box; width: 100%; margin-bottom: 32rpx; }
.note-name-row { margin-bottom: 0; }
.note-grid .note-choice { position: relative; flex: 0 0 calc((100% - 24rpx) / 3); box-sizing: border-box; width: calc((100% - 24rpx) / 3); min-width: 0; max-width: calc((100% - 24rpx) / 3); min-height: 88rpx; margin: 0; padding: 0 14rpx; }
.note-name-row .note-choice.last-note { margin-left: calc((100% - 24rpx) / 3 + 12rpx); }
.note-choice { display: flex; align-items: center; justify-content: center; border: 2rpx solid var(--leta-border); border-radius: 20rpx; background: var(--leta-surface-soft); color: var(--leta-text); font-size: 26rpx; transition: opacity 180ms ease, transform 180ms ease, background 180ms ease; }
.note-choice.selected { border-color: var(--leta-primary); background: var(--leta-practice-soft); color: var(--leta-primary); font-weight: 700; }
.choice-indicator { position: absolute; top: 10rpx; right: 10rpx; width: 12rpx; height: 12rpx; border: 3rpx solid #fff; border-radius: 50%; background: var(--leta-primary); box-shadow: 0 0 0 2rpx var(--leta-primary); }
.note-pressed { opacity: .68; transform: scale(.97); }

.action-stack { display: flex; width: 100%; flex-direction: column; align-items: stretch; gap: 16rpx; margin-top: 28rpx; }
.action-stack button { flex: none; align-self: stretch; width: 100%; max-width: none; margin-left: 0; margin-right: 0; }

.demo-row { min-height: 104rpx; padding: 12rpx 18rpx; justify-content: flex-start; border: 2rpx solid var(--leta-border); border-radius: 22rpx; background: var(--leta-theory-soft); color: var(--leta-text); text-align: left; transition: opacity 180ms ease, transform 180ms ease; }
.demo-button { display: flex; align-items: center; justify-content: center; flex: none; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--leta-primary); }
.play-shape { width: 0; height: 0; margin-left: 6rpx; border-top: 12rpx solid transparent; border-bottom: 12rpx solid transparent; border-left: 19rpx solid #fff; }
.stop-shape { width: 23rpx; height: 23rpx; border-radius: 5rpx; background: #fff; }
.demo-content { min-width: 0; margin-left: 18rpx; }
.demo-title { display: block; font-size: 27rpx; font-weight: 650; }
.demo-copy { display: block; margin-top: 6rpx; color: var(--leta-text-secondary); font-size: 23rpx; }
.demo-pressed { opacity: .72; transform: scale(.99); }

.primary { min-height: 96rpx; border: 0; border-radius: 22rpx; background: var(--leta-primary); color: #fff; font-size: 29rpx; font-weight: 650; box-shadow: 0 8rpx 20rpx rgba(117,106,138,.22); transition: opacity 180ms ease, transform 180ms ease; }
.primary[disabled] { background: #a9a4b8; color: rgba(255,255,255,.86); box-shadow: none; }
.button-pressed { opacity: .82; transform: scale(.985); }
.permission-hint { display: block; margin-top: 16rpx; color: var(--leta-text-secondary); font-size: 23rpx; text-align: center; }
.setup-error { display: block; margin-top: 12rpx; color: var(--leta-error); font-size: 23rpx; line-height: 1.5; text-align: center; }

.practice { padding-top: 4rpx; text-align: center; }
.record-state { display: inline-flex; align-items: center; justify-content: center; gap: 10rpx; min-height: 56rpx; padding: 0 18rpx; margin-bottom: 22rpx; border: 2rpx solid var(--leta-border); border-radius: 999rpx; background: #fff; color: var(--leta-text-secondary); font-size: 23rpx; }
.record-state.recording { background: var(--leta-sing-soft); color: #9e4034; }
.record-state.demo { background: var(--leta-theory-soft); color: #805c12; }
.record-state.playback { background: var(--leta-instrument-soft); color: var(--leta-primary); }
.record-time { min-width: 48rpx; color: currentColor; font-variant-numeric: tabular-nums; }
.record-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #a9a4b0; }
.recording .record-dot { background: var(--leta-sing); box-shadow: 0 0 0 7rpx rgba(242,140,118,.16); }
.demo .record-dot { background: var(--leta-theory); box-shadow: 0 0 0 7rpx rgba(242,198,95,.18); }
.playback .record-dot { background: var(--leta-instrument); box-shadow: 0 0 0 7rpx rgba(145,132,158,.18); }

.current-reading { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7rpx; }
.note-comparison { display: grid; grid-template-columns: minmax(0, 1fr) 54rpx minmax(0, 1fr); align-items: stretch; width: 100%; max-width: 560rpx; padding: 18rpx 22rpx; border: 2rpx solid var(--leta-border); border-radius: 28rpx; background: rgba(255,255,255,.82); box-shadow: var(--leta-shadow-card); }
.note-reading-cell { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; }
.reading-caption { color: var(--leta-text-secondary); font-size: 22rpx; }
.note { margin-top: 4rpx; font-size: 64rpx; font-weight: 720; line-height: 1.06; font-variant-numeric: tabular-nums; }
.target-note-value { margin-top: 8rpx; color: var(--leta-primary); font-size: 44rpx; font-weight: 720; line-height: 1.1; font-variant-numeric: tabular-nums; }
.comparison-divider { display: flex; align-items: center; justify-content: center; }
.comparison-divider view { width: 32rpx; height: 3rpx; border-radius: 999rpx; background: var(--leta-border); }
.status-label { min-height: 42rpx; margin-top: 8rpx; font-size: 29rpx; font-weight: 650; line-height: 1.45; }
.status-label.good { color: var(--leta-success); }
.status-label.off,
.status-label.error { color: var(--leta-error); }
.status-label.listening { color: var(--leta-primary); }
.pitch-number { min-height: 32rpx; color: var(--leta-text-secondary); font-size: 24rpx; font-variant-numeric: tabular-nums; }

.practice-demo { min-width: 244rpx; min-height: 88rpx; margin: 16rpx auto 2rpx; padding: 0 24rpx; gap: 12rpx; border: 2rpx solid var(--leta-border); border-radius: 999rpx; background: var(--leta-theory-soft); color: var(--leta-text); font-size: 25rpx; font-weight: 650; transition: opacity 180ms ease, transform 180ms ease; }
.practice-demo-icon { display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border-radius: 50%; background: #fff; }
.reference-play-shape { width: 0; height: 0; margin-left: 4rpx; border-top: 8rpx solid transparent; border-bottom: 8rpx solid transparent; border-left: 13rpx solid var(--leta-primary); }
.reference-stop-shape { width: 16rpx; height: 16rpx; border-radius: 3rpx; background: var(--leta-primary); }
.practice-demo-pressed { opacity: .72; transform: scale(.98); }

.input-meter { height: 16rpx; margin: 22rpx 0 16rpx; border-radius: 999rpx; background: rgba(68,57,74,.1); overflow: hidden; }
.input-meter-fill { height: 100%; border-radius: inherit; background: var(--leta-instrument); transition: width 180ms ease; }

.pitch-chart { position: relative; width: 100%; height: 540rpx; border: 2rpx solid #4d4677; border-radius: 30rpx; background: var(--leta-chart); box-shadow: 0 12rpx 28rpx rgba(48,42,82,.18); overflow: hidden; }
.pitch-chart-scroll { position: absolute; inset: 0; width: 100%; height: 100%; }
.pitch-chart-track { position: relative; min-width: 100%; height: 100%; overflow: hidden; }
.chart-line { position: absolute; z-index: 0; left: 0; right: 0; height: 1rpx; background: rgba(221,215,205,.18); }
.chart-line.major { height: 2rpx; background: rgba(255,255,255,.42); }
.target-guide { position: absolute; z-index: 1; left: 0; right: 0; height: 8rpx; border-top: 2rpx dashed rgba(184,175,193,.46); background: rgba(184,175,193,.04); transform: translateY(-50%); pointer-events: none; }
.target-guide.active { height: 16rpx; border-top-color: rgba(184,175,193,.98); background: rgba(184,175,193,.16); }
.pitch-segment { position: absolute; z-index: 2; height: 8rpx; border-radius: 999rpx; background: var(--leta-pitch); box-shadow: 0 0 10rpx rgba(143,224,208,.36); transform-origin: left center; }
.pitch-dot { position: absolute; z-index: 2; width: 17rpx; height: 17rpx; border: 4rpx solid #fff; border-radius: 50%; background: var(--leta-theory); box-shadow: 0 0 0 7rpx rgba(242,198,95,.2); transform: translate(-50%,-50%); }
.chart-label-layer { position: absolute; z-index: 4; inset: 0; pointer-events: none; }
.chart-axis-label { position: absolute; left: 13rpx; color: #bcb7cf; font-size: 22rpx; line-height: 26rpx; text-shadow: 0 1rpx 2rpx var(--leta-chart); transform: translateY(-85%); }
.chart-axis-label.major { color: #fff; font-weight: 650; }
.target-guide-label { position: absolute; right: 12rpx; padding: 5rpx 12rpx; border: 2rpx solid rgba(184,175,193,.7); border-radius: 999rpx; background: #f0ebf2; color: #655b6e; font-size: 21rpx; font-weight: 700; line-height: 25rpx; transform: translateY(-50%); }
.chart-empty { position: absolute; z-index: 5; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22rpx; padding: 40rpx; color: #e7e3f1; font-size: 23rpx; line-height: 1.55; pointer-events: none; }
.waveform-preview { display: flex; align-items: center; justify-content: center; gap: 4rpx; width: 78%; height: 112rpx; }
.waveform-preview view { flex: 1; min-width: 3rpx; max-width: 8rpx; border-radius: 999rpx; background: var(--leta-instrument); }
.chart-empty-pulse { position: relative; width: 28rpx; height: 28rpx; border: 3rpx solid #fff; border-radius: 50%; background: var(--leta-instrument); box-shadow: 0 0 0 12rpx rgba(145,132,158,.18); }
.chart-empty-pulse::before,
.chart-empty-pulse::after { content: ""; position: absolute; top: 7rpx; width: 4rpx; height: 6rpx; border-radius: 50%; background: var(--leta-chart); }
.chart-empty-pulse::before { left: 6rpx; }
.chart-empty-pulse::after { right: 6rpx; }

.chart-legend { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 16rpx; color: var(--leta-text-secondary); font-size: 22rpx; line-height: 1.5; text-align: left; }
.chart-legend text:last-child { flex: none; }
.follow-latest { width: 100%; min-height: 88rpx; margin-top: 16rpx; border: 2rpx solid #c9c1f2; border-radius: 22rpx; background: var(--leta-instrument-soft); color: var(--leta-primary); font-size: 25rpx; font-weight: 650; transition: opacity 180ms ease; }
.follow-latest-pressed { opacity: .68; }

.recording-playback { width: 100%; min-height: 100rpx; margin-top: 22rpx; padding: 12rpx 20rpx; justify-content: flex-start; border: 2rpx solid var(--leta-border); border-radius: 24rpx; background: var(--leta-instrument-soft); color: var(--leta-text); text-align: left; transition: opacity 180ms ease, transform 180ms ease; }
.recording-playback.playing { background: var(--leta-theory-soft); }
.recording-playback[disabled] { background: #efede9; color: #8f8998; opacity: .72; }
.recording-playback-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 58rpx; height: 58rpx; border-radius: 50%; background: #fff; }
.recording-playback-copy { display: flex; flex-direction: column; gap: 5rpx; margin-left: 17rpx; }
.recording-playback-copy text:first-child { font-size: 27rpx; font-weight: 650; }
.recording-playback-copy text:last-child { color: var(--leta-text-secondary); font-size: 23rpx; }
.recording-playback-pressed { opacity: .72; transform: scale(.99); }
.playback-progress,
.progress { height: 16rpx; margin-top: 18rpx; border-radius: 999rpx; background: rgba(68,57,74,.1); overflow: hidden; }
.playback-progress view { height: 100%; border-radius: inherit; background: var(--leta-instrument); transition: width 180ms ease; }
.progress { margin-top: 24rpx; }
.progress view { height: 100%; border-radius: inherit; background: var(--leta-theory); }

.bottom-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 24rpx; }
.bottom-actions button { min-height: 96rpx; border: 2rpx solid var(--leta-border); border-radius: 24rpx; background: #fff; color: var(--leta-text); font-size: 27rpx; font-weight: 650; transition: opacity 180ms ease, transform 180ms ease; }
.bottom-actions .pause { border-color: var(--leta-sing); background: var(--leta-sing-soft); color: #8f392f; }
.action-pressed { opacity: .72; transform: scale(.985); }

.finished { padding-top: 42rpx; text-align: center; }
.finish-mark { position: relative; width: 108rpx; height: 108rpx; margin: 0 auto 30rpx; border-radius: 32rpx; background: var(--leta-instrument-soft); box-shadow: var(--leta-shadow-card); transform: rotate(-3deg); }
.finish-check { position: absolute; left: 33rpx; top: 26rpx; width: 30rpx; height: 49rpx; border-right: 7rpx solid var(--leta-success); border-bottom: 7rpx solid var(--leta-success); transform: rotate(42deg); }
.finished .title { max-width: 620rpx; margin: 0 auto; }
.summary { display: flex; margin-top: 34rpx; padding: 28rpx 0; border: 2rpx solid var(--leta-border); border-radius: 28rpx; background: var(--leta-practice-soft); box-shadow: var(--leta-shadow-card); }
.summary view { flex: 1; border-right: 2rpx solid rgba(117,106,138,.12); }
.summary view:last-child { border-right: 0; }
.summary text { display: block; }
.summary text:first-child { font-size: 31rpx; font-weight: 700; }
.summary text:last-child { margin-top: 8rpx; color: var(--leta-text-secondary); font-size: 22rpx; }

.finish-playback-card { margin-top: 32rpx; padding: 24rpx; border: 2rpx solid var(--leta-border); border-radius: 30rpx; background: #fff; box-shadow: var(--leta-shadow-card); }
.finish-playback-title { display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; margin-bottom: 18rpx; text-align: left; }
.finish-playback-title text:first-child { font-size: 28rpx; font-weight: 650; }
.finish-playback-title text:last-child { color: var(--leta-text-secondary); font-size: 22rpx; }
.finish-pitch-chart { height: 340rpx; box-shadow: none; }
.finish-playback-card .recording-playback { min-height: 88rpx; margin-top: 22rpx; justify-content: center; gap: 13rpx; text-align: center; }
.finish-chart-hint { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 72rpx; margin-top: 8rpx; color: var(--leta-text-secondary); font-size: 22rpx; }
.finish-chart-hint .follow-latest { width: auto; min-width: 180rpx; margin-top: 0; padding: 0 18rpx; }
.finish-pitch-chart .target-guide-label { display: none; }
.ghost { width: 100%; min-height: 88rpx; margin-top: 14rpx; border: 0; border-radius: 22rpx; background: transparent; color: var(--leta-text-secondary); font-size: 26rpx; font-weight: 600; }
.ghost-pressed { background: var(--leta-practice-soft); }

@media (max-height: 700px) {
  .pitch-chart { height: 460rpx; }
  .note { font-size: 68rpx; }
}

@media (min-width: 600px) {
  .setup,
  .practice,
  .finished { max-width: 720rpx; margin: 0 auto; }
}

@media (orientation: landscape) {
  .page { padding-left: 48rpx; padding-right: 48rpx; }
  .setup,
  .practice,
  .finished { max-width: 700rpx; margin: 0 auto; }
  .pitch-chart { height: 360rpx; }
}
